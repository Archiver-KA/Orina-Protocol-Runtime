# Required for delegated AI wallet runtime
# Canonical browser bridge path uses the shared runtime function route.
VITE_SUPABASE_AUTH_BRIDGE_ENABLED=true
VITE_SUPABASE_AUTH_BRIDGE_FN_NAME=make-server-b0d68fc8
VITE_SUPABASE_AUTH_BRIDGE_PATH_PREFIX=/auth/supabase-claim-bridge
VITE_SUPABASE_AI_M2M_FN_NAME=orina-ai-m2m-v2
VITE_SUPABASE_AI_M2M_PATH_PREFIX=
VITE_SUPABASE_SELLER_MINTING_FN_NAME=orina-seller-minting-v1
VITE_SUPABASE_RECEIPT_SYNC_FN_NAME=orina-receipt-sync-v1
VITE_WALLET_AUTH_SESSION_TTL_MS=300000

# --- Supabase Edge Functions (Dashboard → Edge Functions → Secrets) ---
SUPABASE_URL=
# Must match Project Settings → API → JWT Secret (same value the API uses to verify user JWTs).
# If this drifts from the project JWT secret, bridge-issued tokens will not authenticate to PostgREST.
# Required minimum: 32 bytes. It must exactly match the project JWT signing secret.
ATP2_SUPABASE_JWT_SECRET=
# Alternative names also accepted by wallet-auth-claim-bridge / request-auth (prefer ATP2_ for clarity):
# SUPABASE_JWT_SECRET=
# JWT_SECRET=

PINATA_JWT=
NVIDIA_API_KEY=
TAVILY_API_KEY=
RAPIDAPI_KEY=
CJ_API_KEY=
# Additional exact public HTTPS hosts accepted for AI image fetches (comma separated).
ATP2_AI_IMAGE_ALLOWED_HOSTS=

ATP2_ENABLE_SUPABASE_AUTH_CLAIM_BRIDGE=true
ATP2_SUPABASE_AUTH_BRIDGE_VERIFY_MODE=wallet_session_row
ATP2_SUPABASE_AUTH_BRIDGE_EXPECTED_CLAIM_VERSION=h1
ATP2_SUPABASE_AUTH_BRIDGE_TTL_SECONDS=900
ATP2_SUPABASE_AUTH_BRIDGE_MAX_TOKEN_TTL_SECONDS=3600
ATP2_SUPABASE_AUTH_BRIDGE_CLIENT_SESSION_MAX_AGE_MS=300000
ATP2_WALLET_AUTH_CHALLENGE_TTL_MS=300000
ATP2_WALLET_SESSION_TTL_MS=86400000
ATP2_WALLET_SESSION_LOCKOUT_IDLE_MS=1800000
# Issuer claim on bridge JWTs; request-auth.ts must agree (default atp2-claim-bridge).
# ATP2_SUPABASE_AUTH_BRIDGE_ISSUER=atp2-claim-bridge

# Production CORS is exact-origin only. Preview hosts must remain disabled unless explicitly approved.
ORINA_CORS_ENV=production
ORINA_CORS_ALLOWED_ORIGINS=
ORINA_CORS_ALLOW_PREVIEW_ORIGINS=false

# Service role: Edge only. Never commit; never set as VITE_*.
# Audit/operator tooling also accepts ATP2_SUPABASE_SERVICE_ROLE_KEY as an alias.
SUPABASE_SERVICE_ROLE_KEY=

# Required minimum: 32 random bytes; rotation requires a ciphertext migration plan.
ATP2_M2M_DELEGATE_ENCRYPTION_KEY=
# At least 32 random characters when the service-to-service header is enabled.
ATP2_M2M_AUTOCONFIRM_SECRET=

# Comma-separated operator wallets authorized for repair/global mutation routes.
ATP2_OPERATOR_WALLET_ALLOWLIST=
ATP2_AUTH_BRIDGE_REPAIR_ALLOWLIST=
ATP2_RUNTIME_MINTED_REPAIR_ALLOWLIST=

# Receipt projection sync: use a dedicated RPC and conservative confirmation depth.
RECEIPT_NFT_ADDRESS=
RECEIPT_CHAIN_ID=97
RECEIPT_DEPLOYMENT_BLOCK=
RECEIPT_SYNC_CONFIRMATIONS=12
RECEIPT_SYNC_MAX_BLOCK_SPAN=50000

# Order keeper: dedicated least-privilege key only; never reuse a deployer/admin key.
ORDER_AUTOTIME_KEEPER_PRIVATE_KEY=
# At least 32 random characters; service-role bearer auth remains the fallback.
ORDER_AUTOTIME_CRON_SECRET=
ORDER_KEEPER_CHAIN_ID=97
BSC_TESTNET_RPC=
MARKETPLACE_ATP_ADDRESS=
AUTOTIME_MANAGER_ADDRESS=
DISPUTE_MANAGER_ADDRESS=
ORINA_RWA_ADDRESS=

# M2M delegated AI wallet contracts. Legacy keys are BSC Testnet aliases.
VITE_M2M_DELEGATION_MANAGER=0xb27C8eCc266423dDA3323983Ae3a2eF691ed8a13
