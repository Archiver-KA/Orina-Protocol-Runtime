# --- Client (Vite): safe to expose in the browser bundle ---
# Only anon/publishable keys and public URLs. Never prefix service role or JWT signing secrets with VITE_.
VITE_SUPABASE_URL=
VITE_SITE_URL=https://app.orina.io
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still read by utils/supabase/info.tsx:
VITE_SUPABASE_LEGACY_ANON_KEY=
VITE_ENABLE_SUPABASE_CONFIG_FALLBACK=false
# Shared namespace for client-side Edge Function calls. Defaults to VITE_SUPABASE_SHARED_SERVER_FN_NAME when unset.
VITE_SUPABASE_FUNCTIONS_NAMESPACE=make-server-b0d68fc8
VITE_SUPABASE_SHARED_SERVER_FN_NAME=make-server-b0d68fc8
VITE_SEPOLIA_RPC_URL=
VITE_APPROX_ETH_USD_RATE=
VITE_ENABLE_TEST_WALLET_FIXTURES=false
VITE_ENABLE_COMMUNITY_MOCK_DATA=false
VITE_ENABLE_SEARCH_DEMO_PANELS=false

# BSC Testnet Starter Kit only. Leave disabled/blank in mainnet builds.
# Values are emitted by foundry/script/DeployTestnetTokenFaucet.s.sol after BSC Testnet broadcast.
# These are faucet mock-token addresses, not mainnet tokens. Remove them from production builds.
VITE_ENABLE_TESTNET_STARTER_KIT=true
VITE_TESTNET_TBNB_FAUCET_URL=
VITE_TESTNET_TOKEN_FAUCET_ADDRESS=0x6527262782C140e0A4724bef06431786556AfDE0
VITE_TESTNET_USDT_T_ADDRESS=0x8800279B4a5528628ef069698169C58B89377809
VITE_TESTNET_USDC_T_ADDRESS=0xbdcA834A71F5BFF1420eb5D1B0491d58a33141E5

# Required for delegated AI wallet runtime
# Canonical browser bridge path uses the shared runtime function route.
VITE_SUPABASE_AUTH_BRIDGE_ENABLED=true
VITE_SUPABASE_AUTH_BRIDGE_FN_NAME=make-server-b0d68fc8
VITE_SUPABASE_AUTH_BRIDGE_PATH_PREFIX=/auth/supabase-claim-bridge
VITE_SUPABASE_AI_M2M_FN_NAME=orina-ai-m2m-v2
VITE_SUPABASE_AI_M2M_PATH_PREFIX=
VITE_SUPABASE_SELLER_MINTING_FN_NAME=orina-seller-minting-v1
VITE_SUPABASE_RECEIPT_SYNC_FN_NAME=orina-receipt-sync-v1
VITE_WALLET_AUTH_SESSION_TTL_MS=604800000

# --- Supabase Edge Functions (Dashboard → Edge Functions → Secrets) ---
# Must match Project Settings → API → JWT Secret (same value the API uses to verify user JWTs).
# If this drifts from the project JWT secret, bridge-issued tokens will not authenticate to PostgREST.
ATP2_SUPABASE_JWT_SECRET=
# Alternative names also accepted by wallet-auth-claim-bridge / request-auth (prefer ATP2_ for clarity):
# SUPABASE_JWT_SECRET=
# JWT_SECRET=

PINATA_JWT=

ATP2_ENABLE_SUPABASE_AUTH_CLAIM_BRIDGE=true
ATP2_SUPABASE_AUTH_BRIDGE_VERIFY_MODE=wallet_session_row
ATP2_SUPABASE_AUTH_BRIDGE_EXPECTED_CLAIM_VERSION=h1
# Issuer claim on bridge JWTs; request-auth.ts must agree (default atp2-claim-bridge).
# ATP2_SUPABASE_AUTH_BRIDGE_ISSUER=atp2-claim-bridge

# Service role: Edge only. Never commit; never set as VITE_*.
# Audit/operator tooling also accepts ATP2_SUPABASE_SERVICE_ROLE_KEY as an alias.
SUPABASE_SERVICE_ROLE_KEY=

ATP2_M2M_DELEGATE_ENCRYPTION_KEY=

# M2M delegated AI wallet contracts (BSC testnet v3.5 beta)
VITE_M2M_DELEGATION_MANAGER=0xb27C8eCc266423dDA3323983Ae3a2eF691ed8a13
VITE_M2M_AI_WALLET_FACTORY_V2=0xD838268fa8dF6AFD1Fd79D9C0Fd243A3D23D0441
